<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NudgeNest"
    Width="472"
    SizeToContent="Height"
    ResizeMode="CanMinimize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    Foreground="#EEF1E9"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    FontSize="13"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display">

    <!-- Same window system as BloxNest: the window draws its own frame and shadow (16 px margin)
         so it can fade and scale when it opens, closes or goes to the hidden icons.
         Every animation is a short WPF storyboard that only runs while something changes. -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="40"
            GlassFrameThickness="0"
            ResizeBorderThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Title-bar buttons: the hover colour (Background) fades in, the icon dips on click -->
        <Style x:Key="CaptionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#2A3027"/>
            <Setter Property="Foreground" Value="#A3AB9C"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" Background="{TemplateBinding Background}" Opacity="0"/>
                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.82" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.82" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#EEF1E9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseCaptionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Background" Value="#C83E45"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Segmented choices: hover and selection fade, tiles press in on click -->
        <Style x:Key="SegmentStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A3AB9C"/>
            <Setter Property="Tag" Value="#E6EBDE"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid x:Name="SegmentRoot" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform/>
                            </Grid.RenderTransform>
                            <Border x:Name="HoverFill" Background="#30372C" CornerRadius="6" Opacity="0"/>
                            <Border x:Name="SelectedFill" Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="6" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#EEF1E9"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#171A16"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectedFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectedFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SegmentRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.92" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="SegmentRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.92" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SegmentRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SegmentRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SegmentRoot" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The big Off / On switch: the On tile lights up mint -->
        <Style x:Key="PowerSegmentStyle" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource SegmentStyle}">
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <!-- Main buttons: hover brightens, click presses the button in and it springs back -->
        <Style x:Key="LaunchButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#102821"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="LaunchRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform/>
                            </Grid.RenderTransform>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
                            <Border x:Name="LaunchOverlay" Background="#FFFFFF" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="PressOverlay" Background="#000000" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LaunchOverlay" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LaunchOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LaunchRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="LaunchRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.94" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="PressOverlay" Storyboard.TargetProperty="Opacity" To="0.10" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LaunchRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="LaunchRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PressOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="LaunchRoot" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource LaunchButtonStyle}">
            <Setter Property="Background" Value="#21261E"/>
            <Setter Property="Foreground" Value="#EEF1E9"/>
            <Setter Property="BorderBrush" Value="#333B2D"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style x:Key="AboutBodyStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#A3AB9C"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="AboutHeadingStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#EEF1E9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#C8CFBF"/>
        </Style>

        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#929C89"/>
        </Style>

        <!-- Options: a row of text with an on/off switch on the right -->
        <Style x:Key="ToggleRowStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <Border x:Name="Track" Grid.Column="1" Width="40" Height="22" CornerRadius="11" VerticalAlignment="Center" BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush Color="#21261E"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#3A4334"/>
                                </Border.BorderBrush>
                                <Border x:Name="Knob" Width="14" Height="14" Margin="3,0,0,0" CornerRadius="7" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                                    <Border.Background>
                                        <SolidColorBrush Color="#A3AB9C"/>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Knob grows a little on hover and slides + recolours when switched -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.15" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.15" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" To="18" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#86E3CE" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#86E3CE" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#171A16" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#21261E" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#3A4334" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#A3AB9C" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#EEF1E9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="OptionHintStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AboutBodyStyle}">
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <!-- Slim dark scrollbar: a thin rounded bar that widens on hover and turns mint while dragged -->
        <Style x:Key="SlimThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Background="Transparent">
                            <Border x:Name="Bar" Width="4" CornerRadius="3" HorizontalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="#3A4334"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Width" To="6" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#5C6852" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Width" To="4" Duration="0:0:0.25"/>
                                            <ColorAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#3A4334" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#86E3CE" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#3A4334" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimPageStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SlimPageStyle}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SlimThumbStyle}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SlimPageStyle}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Starts invisible and slightly small; code fades and scales it in. -->
    <Grid x:Name="WindowRoot" Margin="16" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
        </Grid.RenderTransform>

        <Border CornerRadius="10" Background="#171A16" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.5" Color="#000000"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="10" Background="#171A16" BorderBrush="#2B3228" BorderThickness="1" RenderOptions.ClearTypeHint="Enabled">
        <Grid x:Name="ContentRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- The unoccupied caption area remains draggable. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Margin="24,0,0,0" VerticalAlignment="Center" Text="NudgeNest / ANTI-AFK" FontSize="10" FontWeight="SemiBold" Foreground="#929C89" IsHitTestVisible="False"/>
                <Button x:Name="SettingsButton" Grid.Column="1" Style="{StaticResource CaptionButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True" Content="&#xE713;" ToolTip="Options" AutomationProperties.Name="Options"/>
                <Button x:Name="AboutButton" Grid.Column="2" Style="{StaticResource CaptionButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True" Content="&#xE946;" ToolTip="About and privacy" AutomationProperties.Name="About and privacy"/>
                <Button x:Name="MinButton" Grid.Column="3" Style="{StaticResource CaptionButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True" Content="&#xE921;" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
                <Button x:Name="CloseButton" Grid.Column="4" Style="{StaticResource CloseCaptionButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True" Content="&#xE8BB;" ToolTip="Close to the hidden icons" AutomationProperties.Name="Close"/>
            </Grid>

            <Border Grid.Row="1" Padding="24,14,24,24">
                <Grid>

                <!-- ============ Main ============ -->
                <!-- The other pages stay Hidden (not Collapsed), so the window keeps one height on every page. -->
                <StackPanel x:Name="MainPanel" Visibility="Visible">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="40" Height="40" Margin="0,0,12,0" Stretch="Uniform" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Canvas Width="256" Height="256">
                                <Canvas.RenderTransform>
                                    <RotateTransform Angle="-12" CenterX="128" CenterY="128"/>
                                </Canvas.RenderTransform>
                                <Path Fill="#9AA99F" Data="M28,38 H182 V66 H56 V204 H28 Z"/>
                                <Path Fill="#86E3CE" Data="M76,90 H230 V214 H76 Z"/>
                                <Path x:Name="HeaderLogoLetters" Fill="#102821" Data="F1 M87 182.5 105.9 121.5H113.2L132.1 182.5H120.8L109.6 141.7L98.3 182.5ZM97.5 172.8V162.5H121.9V172.8Z M138.1 182.5V121.5H149.1V182.5ZM142.6 158V147.5H168.4V158ZM142.6 132.1V121.5H171.7V132.1Z M186.3 173.2 185.5 156.5 203.7 121.5H216.8ZM177.9 182.5V121.5H188.9V182.5ZM206.5 182.5 192.5 150.4 201 144.2 219 182.5Z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="NudgeNest" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="SemiBold" Foreground="#EEF1E9"/>
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" Text="A small nudge for your Roblox hangout." FontSize="13" Foreground="#A3AB9C"/>

                    <Grid Margin="0,28,0,10">
                        <TextBlock Text="Anti-AFK" Style="{StaticResource LabelStyle}"/>
                        <!-- Code fills this, e.g. "Nudges after 15 min idle" -->
                        <TextBlock x:Name="IntervalText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#7E8876"/>
                    </Grid>
                    <Border Background="#21261E" BorderBrush="#333B2D" BorderThickness="1" CornerRadius="9" Padding="3">
                        <UniformGrid Rows="1" Columns="2" Height="50">
                            <RadioButton x:Name="OffSegment" Style="{StaticResource PowerSegmentStyle}" GroupName="Power" Content="Off" AutomationProperties.Name="Anti-AFK off"/>
                            <RadioButton x:Name="OnSegment" Style="{StaticResource PowerSegmentStyle}" GroupName="Power" Content="On" Tag="#86E3CE" AutomationProperties.Name="Anti-AFK on"/>
                        </UniformGrid>
                    </Border>

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="NEXT NUDGE" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock x:Name="CountdownText" Margin="0,2,0,0" Text="&#x2014;" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="34" FontWeight="SemiBold" Foreground="#EEF1E9"/>
                            <TextBlock x:Name="CountdownCaption" Text="" FontSize="12" Foreground="#A3AB9C" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,22,0,10">
                        <TextBlock Text="Activity" Style="{StaticResource LabelStyle}"/>
                    </Grid>
                    <Border Background="#21261E" BorderBrush="#333B2D" BorderThickness="1" CornerRadius="9" Padding="3">
                        <UniformGrid x:Name="ActivitySegments" Rows="1" Columns="3" Height="38">
                            <RadioButton Style="{StaticResource SegmentStyle}" GroupName="Activity" Content="Jump"/>
                            <RadioButton Style="{StaticResource SegmentStyle}" GroupName="Activity" Content="Camera nudge"/>
                            <RadioButton x:Name="CustomSegment" Style="{StaticResource SegmentStyle}" GroupName="Activity" Content="Custom key"/>
                        </UniformGrid>
                    </Border>
                    <TextBlock x:Name="ActivityHint" Margin="0,8,0,0" FontSize="12" Foreground="#929C89" TextWrapping="Wrap"/>

                    <Button x:Name="NudgeButton" Margin="0,18,0,0" Background="#86E3CE" Style="{StaticResource LaunchButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="NudgeIcon" Margin="0,0,10,0" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" FontWeight="Normal" Text="&#xE945;"/>
                            <TextBlock x:Name="NudgeText" VerticalAlignment="Center" Text="Nudge now"/>
                        </StackPanel>
                    </Button>

                    <!-- Plain status region, separate from the controls. -->
                    <Border Margin="0,24,0,0" Padding="0,18,0,18" BorderBrush="#30372A" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <Grid MinHeight="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#6B717C"/>
                                <TextBlock x:Name="StatusText" Grid.Column="1" Text="Starting..." Foreground="#C8CFBF" FontSize="13" LineHeight="20" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="18,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SESSION" Style="{StaticResource CaptionStyle}"/>
                                    <TextBlock x:Name="SessionText" Margin="0,3,0,0" Text="&#x2014;" FontSize="13" FontWeight="SemiBold" Foreground="#EEF1E9"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="NUDGES" Style="{StaticResource CaptionStyle}"/>
                                    <TextBlock x:Name="NudgesText" Margin="0,3,0,0" Text="0 ok &#x00B7; 0 failed" FontSize="13" FontWeight="SemiBold" Foreground="#EEF1E9"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="LAST NUDGE" Style="{StaticResource CaptionStyle}"/>
                                    <TextBlock x:Name="LastText" Margin="0,3,0,0" Text="&#x2014;" FontSize="13" FontWeight="SemiBold" Foreground="#EEF1E9"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="0,3,0,0" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="#929C89" Text="&#xE946;"/>
                        <TextBlock Grid.Column="1" FontSize="12" Foreground="#929C89" LineHeight="18" TextWrapping="Wrap"
                                   Text="Closing keeps NudgeNest running in your hidden icons. Right-click it there to quit."/>
                    </Grid>
                </StackPanel>

                <!-- ============ Options ============ -->
                <StackPanel x:Name="SettingsPanel" Visibility="Hidden">
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SettingsBackButton" Style="{StaticResource BackButtonStyle}" Content="&#x2190; Back" AutomationProperties.Name="Back"/>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="OPTIONS" Style="{StaticResource CaptionStyle}"/>
                    </Grid>

                    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Nudge every"/>
                        <TextBlock Style="{StaticResource OptionHintStyle}" Text="How long Roblox can go without input before it's nudged."/>
                        <Border Margin="0,12,0,0" Background="#21261E" BorderBrush="#333B2D" BorderThickness="1" CornerRadius="9" Padding="3">
                            <UniformGrid x:Name="IntervalSegments" Rows="1" Columns="5" Height="38">
                                <RadioButton Style="{StaticResource SegmentStyle}" GroupName="Interval" Content="1 min"/>
                                <RadioButton Style="{StaticResource SegmentStyle}" GroupName="Interval" Content="2 min"/>
                                <RadioButton Style="{StaticResource SegmentStyle}" GroupName="Interval" Content="5 min"/>
                                <RadioButton Style="{StaticResource SegmentStyle}" GroupName="Interval" Content="10 min"/>
                                <RadioButton Style="{StaticResource SegmentStyle}" GroupName="Interval" Content="15 min"/>
                            </UniformGrid>
                        </Border>

                        <Border Margin="0,20,0,0" Padding="0,18,0,18" BorderBrush="#30372A" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Custom key"/>
                                    <TextBlock x:Name="KeyHint" Style="{StaticResource OptionHintStyle}" Text="Esc, Enter, / and other troublesome keys aren't allowed." RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock x:Name="KeyValueText" Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" Text="Not set" FontSize="13" FontWeight="SemiBold" Foreground="#EEF1E9"/>
                                <Button x:Name="ChangeKeyButton" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource BackButtonStyle}" Content="Change"/>
                            </Grid>
                        </Border>

                        <Border Padding="0,18,0,0" BorderBrush="#30372A" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,14" Text="AUTOMATION" Style="{StaticResource CaptionStyle}"/>
                                <CheckBox x:Name="OptAutoRoblox" Style="{StaticResource ToggleRowStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Turn on automatically when Roblox starts"/>
                                        <TextBlock Style="{StaticResource OptionHintStyle}" Text="Goes on standby when Roblox closes."/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="OptLaunch" Style="{StaticResource ToggleRowStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Turn on when NudgeNest opens"/>
                                        <TextBlock Style="{StaticResource OptionHintStyle}" Text="Starts in the On state."/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="OptWindows" Style="{StaticResource ToggleRowStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Start with Windows"/>
                                        <TextBlock Style="{StaticResource OptionHintStyle}" Text="Opens NudgeNest straight to the hidden icons when you sign in."/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Padding="0,18,0,0" BorderBrush="#30372A" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,14" Text="WHILE NUDGING" Style="{StaticResource CaptionStyle}"/>
                                <CheckBox x:Name="OptPause" Style="{StaticResource ToggleRowStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Wait until I stop typing or clicking"/>
                                        <TextBlock Style="{StaticResource OptionHintStyle}" Text="Waits for a 3-second pause, never past 18 idle minutes."/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="OptHide" Style="{StaticResource ToggleRowStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Keep Roblox invisible during a nudge"/>
                                        <TextBlock Style="{StaticResource OptionHintStyle}" Text="Only when Roblox is minimized or covered."/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="OptAwake" Style="{StaticResource ToggleRowStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Keep the PC from sleeping"/>
                                        <TextBlock Style="{StaticResource OptionHintStyle}" Text="While Roblox is open. Your screen can still turn off."/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Padding="0,18,0,0" BorderBrush="#30372A" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Activity log"/>
                                    <TextBlock Style="{StaticResource OptionHintStyle}" Text="Nudges, problems, and Roblox opening and closing."/>
                                </StackPanel>
                                <Button x:Name="ViewLogButton" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource BackButtonStyle}" Content="View"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </StackPanel>

                <!-- ============ About ============ -->
                <StackPanel x:Name="AboutPanel" Visibility="Hidden">
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BackButton" Style="{StaticResource BackButtonStyle}" Content="&#x2190; Back" AutomationProperties.Name="Back"/>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="ABOUT + PRIVACY" Style="{StaticResource CaptionStyle}"/>
                    </Grid>

                    <ScrollViewer MaxHeight="580" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly">
                        <StackPanel Margin="0,0,8,0">
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="64" Height="64" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform" IsHitTestVisible="False">
                                    <Canvas Width="256" Height="256">
                                        <Canvas.RenderTransform>
                                            <RotateTransform Angle="-12" CenterX="128" CenterY="128"/>
                                        </Canvas.RenderTransform>
                                        <Path Fill="#9AA99F" Data="M28,38 H182 V66 H56 V204 H28 Z"/>
                                        <Path Fill="#86E3CE" Data="M76,90 H230 V214 H76 Z"/>
                                        <Path x:Name="AboutLogoLetters" Fill="#102821" Data="F1 M87 182.5 105.9 121.5H113.2L132.1 182.5H120.8L109.6 141.7L98.3 182.5ZM97.5 172.8V162.5H121.9V172.8Z M138.1 182.5V121.5H149.1V182.5ZM142.6 158V147.5H168.4V158ZM142.6 132.1V121.5H171.7V132.1Z M186.3 173.2 185.5 156.5 203.7 121.5H216.8ZM177.9 182.5V121.5H188.9V182.5ZM206.5 182.5 192.5 150.4 201 144.2 219 182.5Z"/>
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="NudgeNest" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="SemiBold" Foreground="#EEF1E9"/>
                                    <TextBlock Margin="0,3,0,0" Text="Made by xRed1" FontSize="13" Foreground="#C8CFBF"/>
                                    <TextBlock x:Name="VersionText" Margin="0,5,0,0" Text="Version" FontSize="12" Foreground="#929C89"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource AboutBodyStyle}" Text="A free, open-source anti-AFK app that keeps Roblox from disconnecting you after 20 idle minutes. Roblox can stay minimized, and your windows are put back after every nudge."/>

                            <Border Margin="0,20,0,0" Padding="0,18,0,0" BorderBrush="#30372A" BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AboutHeadingStyle}" Text="Privacy"/>
                                    <TextBlock Style="{StaticResource AboutBodyStyle}" Text="The app makes no internet connections at all. No accounts, passwords, cookies, analytics, ads or tracking."/>
                                    <TextBlock Margin="0,12,0,0" Style="{StaticResource AboutBodyStyle}" Text="It never sees what you type. To tell whether you're busy, it only asks Windows when your last keyboard or mouse input happened."/>
                                    <TextBlock Margin="0,12,0,0" Style="{StaticResource AboutBodyStyle}" Text="The only files it saves are your options and a small activity log (never more than about 256 KB), in your AppData folder."/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,20,0,0" Padding="0,18,0,0" BorderBrush="#30372A" BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AboutHeadingStyle}" Text="Safety"/>
                                    <TextBlock Style="{StaticResource AboutBodyStyle}" Text="It never touches Roblox's files, memory or process: no injection, no DLLs. It only presses one key, like you would, and checks your windows are back exactly where they were after every nudge."/>
                                    <TextBlock Margin="0,12,0,0" Style="{StaticResource AboutBodyStyle}" Text="Every line is on GitHub under the MIT license. Releases are built by GitHub from that code, with a SHA-256 checksum and a build attestation you can verify."/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,20,0,0" Padding="0,18,0,0" BorderBrush="#30372A" BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AboutHeadingStyle}" Text="Disclaimer"/>
                                    <TextBlock Style="{StaticResource AboutBodyStyle}" Text="Not affiliated with or endorsed by Roblox Corporation. Roblox is a trademark of Roblox Corporation. Nobody can promise anything about bans, so use it at your own risk."/>
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,22,0,0" Orientation="Horizontal">
                                <Button x:Name="WebsiteButton" Style="{StaticResource BackButtonStyle}" Content="Website"/>
                                <Button x:Name="SourceButton" Margin="10,0,0,0" Style="{StaticResource BackButtonStyle}" Content="Source code"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>

                <!-- ============ Activity log ============ -->
                <StackPanel x:Name="LogPanel" Visibility="Hidden">
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="LogBackButton" Style="{StaticResource BackButtonStyle}" Content="&#x2190; Back" AutomationProperties.Name="Back"/>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="ACTIVITY LOG" Style="{StaticResource CaptionStyle}"/>
                    </Grid>
                    <Border Background="#1C2019" BorderBrush="#2B3228" BorderThickness="1" CornerRadius="8" Padding="12,10,4,10">
                        <ScrollViewer x:Name="LogScroll" Height="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                            <TextBlock x:Name="LogText" Margin="0,0,8,0" FontFamily="Cascadia Mono, Consolas" FontSize="11" LineHeight="18" Foreground="#A3AB9C" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#929C89" TextWrapping="Wrap" Text="Only the newest entries are kept, so the file stays small."/>
                        <Button x:Name="OpenLogButton" Grid.Column="1" Style="{StaticResource BackButtonStyle}" Content="Open log file"/>
                    </Grid>
                </StackPanel>

                </Grid>
            </Border>
        </Grid>
        </Border>
    </Grid>
</Window>
